FROM node:22-bookworm-slim AS node
FROM composer:2.8 AS composer
FROM php:8.4-fpm-bookworm AS php-base
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev libicu-dev libzip-dev libpng-dev libjpeg62-turbo-dev libwebp-dev unzip && docker-php-ext-configure gd --with-jpeg --with-webp && docker-php-ext-install pdo_pgsql intl zip bcmath pcntl gd opcache && rm -rf /var/lib/apt/lists/*
WORKDIR /var/www/html
ENV DB_CONNECTION=pgsql

FROM php-base AS build
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/root/.composer/cache composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
COPY . .
RUN mkdir -p storage/framework/cache/data storage/framework/views storage/framework/sessions storage/logs bootstrap/cache && composer dump-autoload --no-dev --optimize --no-interaction
RUN php artisan wayfinder:generate --with-form && npm run build

FROM php-base AS app
COPY --from=build --chown=www-data:www-data /var/www/html/app ./app
COPY --from=build --chown=www-data:www-data /var/www/html/bootstrap ./bootstrap
COPY --from=build --chown=www-data:www-data /var/www/html/config ./config
COPY --from=build --chown=www-data:www-data /var/www/html/database ./database
COPY --from=build --chown=www-data:www-data /var/www/html/public ./public
COPY --from=build --chown=www-data:www-data /var/www/html/resources/views ./resources/views
COPY --from=build --chown=www-data:www-data /var/www/html/routes ./routes
COPY --from=build --chown=www-data:www-data /var/www/html/vendor ./vendor
COPY --from=build --chown=www-data:www-data /var/www/html/artisan /var/www/html/composer.json ./
COPY deploy/entrypoint.sh /usr/local/bin/business-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/business-entrypoint && chmod 755 /usr/local/bin/business-entrypoint && mkdir -p storage/app/private storage/framework/cache/data storage/framework/views storage/framework/sessions storage/logs && chown -R www-data:www-data storage bootstrap/cache && printf '\nclear_env = no\n' >> /usr/local/etc/php-fpm.d/www.conf
USER www-data
ENTRYPOINT ["business-entrypoint"]
CMD ["php-fpm", "-F"]

FROM caddy:2-alpine AS web
COPY --from=build /var/www/html/public /var/www/html/public
COPY deploy/Caddyfile /etc/caddy/Caddyfile
